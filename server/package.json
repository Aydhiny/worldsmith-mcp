{
  "name": "@worldsmith/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing deterministic geometry validators (overlap, zone-bounds, jump reachability) for AI-generated Unity level layouts. Validates plain JSON before any engine is involved — a builder only ever consumes a layout this server has approved.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "worldsmith-mcp": "dist/index.js",
    "worldsmith": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p . && npm run build:browser",
    "build:browser": "esbuild src/browser.ts --bundle --format=esm --outfile=../ui/vendor/worldsmith-core.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "export-schema": "node dist/export-schema.js",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
